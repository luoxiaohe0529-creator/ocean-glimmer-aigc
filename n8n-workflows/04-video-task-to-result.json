          "jsCode": "const body = $input.first().json.body || {};\nif (!body.video_task_id) {\n  return [{ json: { ok: false, status: 'rejected', error: '缺少 video_task_id' } }];\n}\nreturn [{ json: {\n  ok: true,\n  video_task_id: body.video_task_id,\n  product_record_id: body.product_record_id || '',\n  status: 'queued',\n  video_url: '',\n  result_url: '',\n  public_url: '',\n  provider: 'Seedance 2.0',\n  duration_seconds: 15,\n  aspect_ratio: '9:16',\n  message: '视频任务已进入生成队列。接入 Seedance 凭证后，此节点可替换为真实的提交与轮询节点。',\n  product_image_url: body.product_image_url || ''\n} }];"
        }
