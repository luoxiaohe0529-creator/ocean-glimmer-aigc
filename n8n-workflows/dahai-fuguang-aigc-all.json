          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const body = $input.first().json.body || {};\nif (!String(body.script_text || '').trim()) {\n  return [{ json: { ok: false, error: '缺少已确认的 script_text' } }];\n}\nconst taskId = 'video_task_' + Date.now();\nconst creator = String(body.creator_profile || '').trim() || '自然、可信、像朋友推荐产品的年轻达人';\nreturn [{ json: {\n  ok: true,\n  video_task_id: taskId,\n  task_id: taskId,\n  product_record_id: body.product_record_id || '',\n  status: 'submitted',\n  duration_seconds: 15,\n  aspect_ratio: '9:16',\n  provider: 'Seedance 2.0',\n  creator_profile: creator,\n  task_preview: {\n    script_text: body.script_text,\n    language: body.language || '中文',\n    content_type: body.content_type || '固定达人口播',\n    creator_profile: creator\n  }\n} }];"
