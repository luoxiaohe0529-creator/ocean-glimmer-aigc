# Copy this file to .env and replace the placeholders that you use.

# Local services
PORT=4173
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8787
PYTHON_SERVICE_URL=http://127.0.0.1:8787
FRONTEND_BASE_URL=http://127.0.0.1:4173
PYTHON_BIN=python3
SCRAPER_SERVICE_ENABLED=1
SCRAPER_SERVICE_PORT=9876
SCRAPER_SERVICE_URL=http://127.0.0.1:9876
# Leave empty to use Playwright's bundled browser. Set to chrome only when Chrome is installed.
PLAYWRIGHT_BROWSER_CHANNEL=

# n8n is a separate service; start it independently.
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_PREFIX=webhook
N8N_ASSET_UPLOAD_WORKFLOW=ai-ad-asset-upload
N8N_STAGE2_OPTIMIZE_WORKFLOW=ai-ad-hook-optimize
N8N_STAGE4_WORKFLOW=ai-ad-video-task-v2
N8N_STAGE5_WORKFLOW=aigc-storyboard-images-v1
N8N_STAGE6_WORKFLOW=ai-ad-video-concat
N8N_REQUEST_TIMEOUT_MS=180000
N8N_VIDEO_REQUEST_TIMEOUT_MS=600000

# Public object-storage URL used by the browser after image upload.
TOS_PUBLIC_BASE_URL=https://YOUR_BUCKET.tos-cn-beijing.volces.com
TOS_BUCKET=YOUR_BUCKET
TOS_REGION=cn-beijing

# Content models
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Stage 1 multimodal creative model. Keep the key in local .env only.
DOUBAO_API_KEY=YOUR_DOUBAO_API_KEY
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_TIMEOUT_SECONDS=120
# KIE remains the image/video task adapter and Stage 2/3 Chinese text path.
KIE_API_KEY=YOUR_KIE_API_KEY
KIE_API_BASE_URL=https://api.kie.ai
KIE_CALLBACK_URL=
KIE_CHARACTER_MODEL=gpt-image-2-text-to-image
KIE_STORYBOARD_MODEL=nano-banana-pro
KIE_OVERSEAS_VIDEO_MODEL=veo3_fast
KIE_KLING_VIDEO_MODEL=kling-3.0/video
KIE_KLING_VIDEO_MODE=pro

# Feishu Wiki knowledge
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
FEISHU_PLANNING_WIKI_TOKEN=YOUR_PLANNING_WIKI_TOKEN
FEISHU_DIRECTOR_WIKI_TOKEN=YOUR_DIRECTOR_WIKI_TOKEN
FEISHU_CAMERA_WIKI_TOKEN=YOUR_CAMERA_WIKI_TOKEN
FEISHU_KNOWLEDGE_CACHE_SECONDS=300
LARK_CLI=lark-cli
FEISHU_SCHEMA=
SOURCE_FEISHU_BASE_TOKEN=YOUR_SOURCE_FEISHU_BASE_TOKEN
SOURCE_FEISHU_TABLE_ID=YOUR_SOURCE_FEISHU_TABLE_ID

# Optional media providers
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY
MINIMAX_API_BASE_URL=https://api.minimaxi.com
MINIMAX_MUSIC_MODEL=music-3.0
TOPAZ_API_KEY=YOUR_TOPAZ_API_KEY
TOPAZ_API_BASE_URL=https://api.topazlabs.com
TOPAZ_VIDEO_MODEL=ghq-5

# Media tools. Leave FFMPEG_PATH empty to discover ffmpeg from PATH.
FFMPEG_PATH=
WHISPER_MODEL=base
REALESRGAN_PATH=
REALESRGAN_MODELS=

# Local UI / test mode. Set to 1 to avoid external model calls.
PYTHON_MOCK_MODE=0
